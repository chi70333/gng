# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-northeast-2.aws.neon.tech/gng?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-northeast-2.aws.neon.tech/gng?sslmode=require"

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Auth.js ---
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Production: https://xn--ef5bt3fba.shop
# Local dev follows package.json: http://localhost:4000
AUTH_URL="http://localhost:4000"

# --- Social Login ---
# Kakao: KAKAO_CLIENT_ID is the REST API key.
# Kakao Admin Key is not used by OAuth login and must never be exposed to the app.
# Kakao Redirect URI:
# - Production: https://xn--ef5bt3fba.shop/api/auth/callback/kakao
# - Local dev: http://localhost:4000/api/auth/callback/kakao
KAKAO_CLIENT_ID=""
# Optional. Only set this if Kakao Login > Security > Client Secret is enabled.
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# --- Local Seed Admin ---
# pnpm db:seed creates admin / Admin1234! for local development.

# --- Storage (Cloudflare R2 or S3) ---
R2_ACCOUNT_ID="777451772a87c0cd315cb84646206451"
R2_ENDPOINT_URL="https://777451772a87c0cd315cb84646206451.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gngtest"
R2_PUBLIC_URL="https://pub-6d6f31f5f36746d9b28ec88fa437bf14.r2.dev"

# --- Search ---
MEILI_HOST=""
MEILI_KEY=""
MEILI_PRODUCT_INDEX="products"
MEILI_BATCH_SIZE="500"

# --- Queue (Upstash QStash) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Monitoring ---
SENTRY_DSN=""

# --- Legacy API Compatibility ---
# Keep real partner tokens only in environment variables or secret managers.
# Do not copy historical PHP literals into source code, docs, tests, or commits.
LEGACY_API_TOKEN=""
PAYMENT_CALLBACK_TOKEN=""
# Optional deep verification. These are off by default so normal tests never write
# member or point data by accident.
GNG_TEST_USER_PREFIX="gng_ext"
GNG_DB_INTEGRATION_TEST_ENABLED="0"
GNG_EXT_TEST_ENABLED="0"
# Staging deployment only, for example: https://gng-staging.vercel.app
GNG_EXT_TEST_BASE_URL=""
GNG_EXT_TEST_TOKEN=""
# Keep empty unless an intentional production smoke test is approved.
GNG_EXT_TEST_ALLOW_PRODUCTION="0"
GNG_E2E_AUTH_TEST_ENABLED="0"

# --- Legacy Product Migration ---
# Example: https://www.example.co.kr (no trailing slash)
LEGACY_BASE_URL=""
# Comma-separated category Index values from goods_list.php?Index=...&sty_num=1
LEGACY_CATEGORY_INDEXES=""
# Set to 1 to crawl and report without writing Product/Category rows.
LEGACY_MIGRATION_DRY_RUN="1"
LEGACY_MAX_PAGES_PER_CATEGORY="50"
# remote keeps legacy URLs during migration; r2-ready records the intent after object migration.
LEGACY_IMAGE_STRATEGY="remote"
# Hostname only, used by next.config.mjs image remotePatterns during the migration window.
LEGACY_IMAGE_HOSTNAME=""
# Defaults to https. Use http only for a temporary internal legacy host.
LEGACY_IMAGE_PROTOCOL="https"
LEGACY_EXPECTED_PRODUCT_COUNT=""
LEGACY_EXPECTED_CATEGORY_COUNT=""

# --- Legacy Member Migration ---
# NDJSON file downloaded from scripts/legacy-member-backup.php?action=download-json.
LEGACY_MEMBER_BACKUP_FILE="legacy-member-backups/gng_member_backup_YYYYMMDD_HHMMSS.ndjson"
# Always run 1 first. Set to 0 only after reviewing the generated report.
LEGACY_MEMBER_MIGRATION_DRY_RUN="1"
LEGACY_MEMBER_REPORT_DIR="legacy-member-backups/reports"
# Optional legacy social_member column overrides when automatic detection is not enough.
LEGACY_MEMBER_SOCIAL_PROVIDER_COLUMN=""
LEGACY_MEMBER_SOCIAL_PROVIDER_UID_COLUMN=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:4000"
